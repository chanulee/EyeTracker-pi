# Mac mini에서 접근 가능한 1P Pi 주소. SORA(2P)는 안내 시나리오만 사용합니다.
PI_SENSOR_URL_1=http://eye-pi-1.local:8080
PI_MIC_MODE=ondemand
NEXT_PUBLIC_GAZE_SOURCE=pi
NEXT_PUBLIC_MIC_SOURCE=pi
# IMU 장착 방향에 맞춰 부호/배율을 조절하세요. 0이면 해당 축은 고정됩니다.
NEXT_PUBLIC_IMU_YAW_GAIN=1
NEXT_PUBLIC_IMU_PITCH_GAIN=1
# 선택: 비어 있으면 원본의 로컬 질문/브라우저 음성 합성을 사용합니다.
OPENAI_API_KEY=
# DeepVOG 검증 + 지연 필터. 기존 camera_accuracy의 모델과 설치 환경을 재사용합니다.
EYE_TRACKER=deepvog-verified

EYE_TRACKER_PYTHON=../camera_accuracy/.venv/bin/python
KERAS_BACKEND=torch
PYTORCH_ENABLE_MPS_FALLBACK=1
